# Use none for deterministic rules-only mode.
AI_PROVIDER=none

# Populate only the key for the selected provider.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional comma-separated origins for a separately hosted frontend.
# Example: https://your-project.github.io,https://www.example.com
ALLOWED_ORIGINS=

# Optional Groq model override.
GROQ_MODEL=llama-3.1-8b-instant
